{
  "redirects": [
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.kingmediaglobal.com"
        }
      ],
      "destination": "https://teveotv.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.kingmediaglobal.com"
        }
      ],
      "destination": "https://teveotv.com/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "kingmediaglobal.com"
        }
      ],
      "destination": "https://teveotv.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kingmediaglobal.com"
        }
      ],
      "destination": "https://teveotv.com/",
      "permanent": true
    },
    {
      "source": "/download/teveo.apk",
      "destination": "https://github.com/soycaxte-lab/teveo-website/releases/download/teveo-v0.20.12/TEVEO-v0.20.12.apk",
      "permanent": false
    },
    {
      "source": "/teveo",
      "destination": "/download/teveo.apk",
      "permanent": false
    },
    {
      "source": "/teveo/",
      "destination": "/download/teveo.apk",
      "permanent": false
    },
    {
      "source": "/activar",
      "destination": "https://activar.teveotv.com",
      "permanent": false
    },
    {
      "source": "/activar/",
      "destination": "https://activar.teveotv.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/windows",
      "destination": "/api/windows-download"
    },
    {
      "source": "/windows/",
      "destination": "/api/windows-download"
    },
    {
      "source": "/download/teveo.exe",
      "destination": "/api/windows-download"
    },
    {
      "source": "/updates/android-tv.json",
      "destination": "/android-tv.json"
    },
    {
      "source": "/descargar",
      "destination": "/descargar.html"
    },
    {
      "source": "/descargar/",
      "destination": "/descargar.html"
    }
  ],
  "headers": [
    {
      "source": "/updates/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/android-tv.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/download/teveo.apk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/statarena.js": {
      "maxDuration": 60
    },
    "api/windows-download.js": {
      "includeFiles": "updates/windows-stable.json"
    },
    "api/cinema-refresh.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cinema-refresh",
      "schedule": "0 10 * * *"
    }
  ]
}
