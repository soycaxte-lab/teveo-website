{
  "redirects": [
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.kingmediaglobal.com"
        }
      ],
      "destination": "https://teveotv.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.kingmediaglobal.com"
        }
      ],
      "destination": "https://teveotv.com/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "kingmediaglobal.com"
        }
      ],
      "destination": "https://teveotv.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kingmediaglobal.com"
        }
      ],
      "destination": "https://teveotv.com/",
      "permanent": true
    },
    {
      "source": "/download/teveo.apk",
      "destination": "https://github.com/soycaxte-lab/teveo-website/releases/download/teveo-v0.20.12/TEVEO-v0.20.12.apk",
      "permanent": false
    },
    {
      "source": "/teveo",
      "destination": "/download/teveo.apk",
      "permanent": false
    },
    {
      "source": "/teveo/",
      "destination": "/download/teveo.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/updates/android-tv.json",
      "destination": "/android-tv.json"
    },
    {
      "source": "/descargar",
      "destination": "/descargar.html"
    },
    {
      "source": "/descargar/",
      "destination": "/descargar.html"
    }
  ],
  "headers": [
    {
      "source": "/updates/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/android-tv.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/download/teveo.apk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/statarena.js": {
      "maxDuration": 60
    }
  }
}
